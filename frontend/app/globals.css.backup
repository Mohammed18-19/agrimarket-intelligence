@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: light;
  --forest: #064e3b;
  --forest-deep: #022c22;
  --emerald: #059669;
  --leaf: #22c55e;
  --mint: #d1fae5;
  --page: #f0f7f1;
  --surface: rgba(255, 255, 255, 0.88);
  --text: #12372a;
  --muted: #718579;
  --border: rgba(6, 78, 59, 0.12);
  --shadow: 0 18px 55px rgba(6, 50, 32, 0.09);
}

html.dark {
  color-scheme: dark;
  --forest: #052e25;
  --forest-deep: #011b16;
  --emerald: #34d399;
  --leaf: #4ade80;
  --mint: #064e3b;
  --page: #071b15;
  --surface: rgba(13, 39, 29, 0.9);
  --text: #e4f5e9;
  --muted: #a0b8a8;
  --border: rgba(167, 243, 208, 0.13);
  --shadow: 0 18px 55px rgba(0, 0, 0, 0.24);
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
  scroll-padding-top: 24px;
}

body {
  min-height: 100vh;
  margin: 0;
  background: var(--page);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  transition: background-color 250ms ease, color 250ms ease;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
}

* {
  box-sizing: border-box;
}

::selection {
  background: #a7f3d0;
  color: #022c22;
}

.glass-panel {
  border: 1px solid var(--border);
  background: var(--surface);
  box-shadow: var(--shadow);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.dashboard-card {
  border: 1px solid var(--border);
  border-radius: 24px;
  background: var(--surface);
  box-shadow: var(--shadow);
  transition:
    transform 220ms ease,
    border-color 220ms ease,
    box-shadow 220ms ease,
    background-color 220ms ease;
}

.dashboard-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 22px 55px rgba(6, 50, 32, 0.13);
}

.animate-enter {
  animation: enter 650ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

@keyframes enter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* AgriMarket visual system */
:root {
  --forest: #064e3b;
  --forest-deep: #022c22;
  --emerald: #059669;
  --leaf: #22c55e;
  --mint: #d1fae5;
  --page: #f0f7f1;
  --surface: rgba(255,255,255,.91);
  --text: #12372a;
  --muted: #718579;
  --border: rgba(6,78,59,.13);
  --shadow: 0 18px 55px rgba(6,50,32,.08);
}

html.dark {
  color-scheme: dark;
  --forest: #052e25;
  --forest-deep: #011b16;
  --emerald: #34d399;
  --leaf: #4ade80;
  --mint: #064e3b;
  --page: #071b15;
  --surface: rgba(13,39,29,.94);
  --text: #e4f5e9;
  --muted: #a0b8a8;
  --border: rgba(167,243,208,.15);
  --shadow: 0 18px 55px rgba(0,0,0,.22);
}

.agri-app {
  color: var(--text);
  background:
    radial-gradient(ellipse at 5% 0%, rgba(16,185,129,.10), transparent 32rem),
    radial-gradient(ellipse at 100% 30%, rgba(132,204,22,.07), transparent 28rem),
    var(--page);
  transition: background-color .25s ease, color .25s ease;
}

html.dark body { background: var(--page); color: var(--text); }
html.dark .agri-app { background: radial-gradient(ellipse at 0% 0%, rgba(16,185,129,.10), transparent 35rem), var(--page); }
html.dark .dashboard-card {
  background: var(--surface) !important;
  border-color: var(--border) !important;
  color: var(--text);
}
html.dark .dashboard-card h2,
html.dark .dashboard-card h3,
html.dark .dashboard-card p,
html.dark .dashboard-card span,
html.dark .dashboard-card label,
html.dark .dashboard-card td,
html.dark .dashboard-card th { color: inherit; }
html.dark .dashboard-card input,
html.dark .dashboard-card textarea,
html.dark .dashboard-card select,
html.dark .agri-app input,
html.dark .agri-app textarea,
html.dark .agri-app select {
  background-color: #102d21;
  border-color: rgba(167,243,208,.18);
  color: #e4f5e9;
}
html.dark .agri-app nav a {
  background: #102d21;
  border-color: var(--border);
  color: #d6eee0;
}
html.dark .agri-app nav a:hover { background: #174632; }
html.dark .agri-app [class*="bg-white"] { background-color: #102d21; }
html.dark .agri-app [class*="bg-[#f"] { background-color: #102d21; }
html.dark .agri-app [class*="border-[#e"] { border-color: var(--border); }
html.dark .agri-app [class*="text-[#"] { color: #c3d9ca; }
html.dark .agri-app .dashboard-card pre { background: #071b15; color: #d6eee0; }

.dashboard-card {
  border: 1px solid var(--border);
  border-radius: 24px;
  background: var(--surface);
  box-shadow: var(--shadow);
  backdrop-filter: blur(16px);
  transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
}
.dashboard-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 22px 55px rgba(6,50,32,.12);
}
.agri-hero {
  background:
    linear-gradient(110deg, rgba(2,44,34,.98) 0%, rgba(6,78,59,.94) 58%, rgba(5,105,72,.86) 100%),
    url("https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1800&q=85") center/cover;
  isolation: isolate;
}
.agri-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  opacity: .25;
  background-image: radial-gradient(rgba(209,250,229,.45) .7px, transparent .7px);
  background-size: 18px 18px;
  mask-image: linear-gradient(90deg, transparent, black);
}
.agri-globe-wrap {
  position: absolute;
  right: 4%;
  top: 50%;
  width: 210px;
  height: 210px;
  transform: translateY(-50%);
  pointer-events: none;
  opacity: .9;
}
.agri-globe {
  position: absolute;
  inset: 18px;
  border-radius: 50%;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 32% 27%, rgba(209,250,229,.95), transparent 12%),
    radial-gradient(ellipse at 65% 60%, rgba(34,197,94,.2), transparent 45%),
    url("https://images.unsplash.com/photo-1614730321146-b6fa6a46bcb4?auto=format&fit=crop&w=600&q=85") center/cover,
    #087f5b;
  box-shadow: inset -20px -10px 35px rgba(1,25,18,.65), 0 0 50px rgba(52,211,153,.22);
  animation: agri-globe-float 7s ease-in-out infinite;
}
.agri-globe-shine {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: linear-gradient(110deg, rgba(255,255,255,.24), transparent 40%, rgba(0,0,0,.32));
}
.agri-orbit {
  position: absolute;
  inset: 0;
  border: 1px solid rgba(209,250,229,.4);
  border-radius: 50%;
  transform: rotate(-25deg) scaleY(.42);
}
.agri-orbit-two {
  inset: 10px -5px;
  transform: rotate(48deg) scaleY(.65);
  border-color: rgba(134,239,172,.4);
}
@keyframes agri-globe-float {
  0%, 100% { transform: translateY(0) rotate(-4deg); }
  50% { transform: translateY(-8px) rotate(4deg); }
}
.agri-theme-toggle { backdrop-filter: blur(12px); }
.agri-app nav { position: sticky; top: 8px; z-index: 20; }
.agri-app nav a { box-shadow: 0 3px 12px rgba(6,50,32,.035); }
.animate-enter { animation: agri-enter .55s cubic-bezier(.2,.7,.2,1) both; }
@keyframes agri-enter {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
@media (max-width: 900px) {
  .agri-globe-wrap { right: 12px; width: 125px; height: 125px; opacity: .45; }
  .agri-hero { padding-right: 20px; }
}
@media (max-width: 640px) {
  .agri-globe-wrap { display: none; }
  .agri-app nav { position: static; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

/* ===== Agriculture AI dashboard reference redesign ===== */
:root {
  --forest: #092f20;
  --forest-deep: #061f17;
  --emerald: #38a65b;
  --leaf: #91d76d;
  --mint: #d6f5c8;
  --page: #081f17;
  --surface: rgba(17, 48, 34, .91);
  --text: #edf7e9;
  --muted: #a2bba6;
  --border: rgba(183, 225, 174, .16);
  --shadow: 0 12px 36px rgba(0, 0, 0, .18);
}

html, body {
  background: #081f17;
  color: var(--text);
}

.agri-app {
  min-height: 100vh;
  color: var(--text);
  background:
    linear-gradient(135deg, rgba(4, 24, 16, .97), rgba(8, 38, 25, .96)),
    url("https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=2000&q=85") center / cover fixed;
  display: grid;
  grid-template-columns: 218px minmax(0, 1fr);
  grid-template-rows: auto auto;
  align-content: start;
  gap: 16px;
  padding: 22px;
}

.agri-app > header {
  grid-column: 2;
  grid-row: 1;
  min-height: 220px;
  border: 1px solid rgba(194, 232, 183, .18);
  border-radius: 20px;
  background:
    linear-gradient(90deg, rgba(4, 30, 19, .97), rgba(8, 43, 27, .82) 58%, rgba(8, 43, 27, .55)),
    url("https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1800&q=85") center 48% / cover;
  box-shadow: 0 18px 45px rgba(0,0,0,.22);
}

.agri-app > nav {
  grid-column: 1;
  grid-row: 1 / span 2;
  position: sticky;
  top: 22px;
  align-self: start;
  min-height: calc(100vh - 44px);
  display: flex;
  flex-direction: column;
  flex-wrap: nowrap;
  gap: 7px;
  padding: 18px 12px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: rgba(8, 34, 23, .96);
  box-shadow: var(--shadow);
  backdrop-filter: blur(18px);
}

.agri-app > nav a {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 42px;
  padding: 10px 12px;
  border: 1px solid transparent;
  border-radius: 11px;
  color: #b8d0ba;
  background: transparent;
  box-shadow: none;
  text-decoration: none;
  transition: background .2s ease, color .2s ease, transform .2s ease;
}

.agri-app > nav a:hover,
.agri-app > nav a:focus-visible {
  color: #f2ffed;
  background: rgba(68, 151, 81, .18);
  border-color: rgba(145, 215, 109, .2);
  transform: translateX(2px);
}

.agri-app > section {
  grid-column: 2;
  min-width: 0;
}

.agri-app > section,
.agri-app article,
.agri-app .dashboard-card {
  color: var(--text);
}

.agri-app article,
.agri-app > section#crop-explorer,
.agri-app > section#ai-advisor,
.agri-app > section#data-methods {
  border: 1px solid var(--border) !important;
  border-radius: 18px !important;
  background: var(--surface) !important;
  color: var(--text);
  box-shadow: var(--shadow);
  backdrop-filter: blur(16px);
}

.agri-app article:hover {
  border-color: rgba(145, 215, 109, .3) !important;
}

.agri-app h1,
.agri-app h2,
.agri-app h3,
.agri-app h4 {
  color: #f0f8eb !important;
  letter-spacing: -.025em;
}

.agri-app p,
.agri-app label,
.agri-app span {
  border-color: var(--border);
}

.agri-app p {
  color: #b5cbb8;
}

.agri-app input,
.agri-app textarea,
.agri-app select {
  color: #eef8e9 !important;
  background: rgba(4, 25, 17, .78) !important;
  border-color: rgba(183, 225, 174, .2) !important;
  border-radius: 10px;
}

.agri-app button {
  transition: transform .18s ease, filter .18s ease, border-color .18s ease;
}

.agri-app button:hover {
  filter: brightness(1.09);
}

.agri-app .recharts-cartesian-grid-horizontal line,
.agri-app .recharts-cartesian-grid-vertical line {
  stroke: rgba(200, 230, 195, .12);
}

.agri-app .recharts-text {
  fill: #b5cbb8;
}

.agri-app .agri-theme-toggle {
  border: 1px solid rgba(209, 250, 229, .25);
  background: rgba(5, 32, 21, .65);
  color: #e8f7df;
}

.agri-app .agri-globe-wrap {
  opacity: .48;
}

.agri-app .dashboard-card {
  border-color: var(--border);
  background: var(--surface);
}

html:not(.dark) body {
  background: #081f17;
}

@media (max-width: 900px) {
  .agri-app {
    display: flex;
    flex-direction: column;
    padding: 12px;
    gap: 12px;
  }

  .agri-app > header {
    order: 0;
    min-height: 190px;
  }

  .agri-app > nav {
    order: 1;
    position: static;
    min-height: 0;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 10px;
  }

  .agri-app > nav a {
    flex: 1 1 130px;
  }

  .agri-app > section {
    order: 2;
    width: 100%;
  }
}

@media (max-width: 560px) {
  .agri-app > header {
    padding: 20px !important;
  }

  .agri-app > nav a {
    flex: 1 1 100px;
    font-size: 12px;
  }
}

/* Make the Earth globe prominent in the hero */
.agri-app .agri-globe-wrap {
  display: block !important;
  width: 300px !important;
  height: 300px !important;
  right: 5% !important;
  opacity: 1 !important;
  z-index: 1;
}

.agri-app .agri-globe {
  inset: 24px !important;
  background:
    radial-gradient(circle at 28% 25%, rgba(255,255,255,.35), transparent 35%),
    url("https://images.unsplash.com/photo-1614730321146-b6fa6a46bcb4?auto=format&fit=crop&w=900&q=90") center / cover,
    #087f5b !important;
  box-shadow:
    inset -28px -14px 40px rgba(1,20,14,.55),
    0 0 0 1px rgba(190,255,202,.35),
    0 0 65px rgba(52,211,153,.3) !important;
}

.agri-app .agri-orbit {
  border-color: rgba(190,255,202,.65) !important;
}

@media (max-width: 700px) {
  .agri-app .agri-globe-wrap {
    width: 145px !important;
    height: 145px !important;
    right: 0 !important;
    opacity: .55 !important;
  }
}

/* Earth globe with warm orbital rings */
.agri-app .agri-globe-wrap {
  display: block !important;
  position: absolute !important;
  width: 320px !important;
  height: 320px !important;
  right: 4% !important;
  top: 50% !important;
  transform: translateY(-50%);
  opacity: 1 !important;
  z-index: 2;
  pointer-events: none;
}

.agri-app .agri-globe {
  background:
    url("https://images.unsplash.com/photo-1614730321146-b6fa6a46bcb4?auto=format&fit=crop&w=900&q=90")
    center / cover,
    #087f5b !important;
  border-radius: 50%;
  box-shadow:
    inset -28px -18px 42px rgba(0, 0, 0, .55),
    0 0 45px rgba(34, 197, 94, .22);
}

.agri-app .agri-orbit {
  border: 1px solid rgba(255, 174, 92, .9) !important;
  box-shadow: 0 0 12px rgba(255, 151, 70, .25);
}

.agri-app .agri-orbit-two {
  border-color: rgba(255, 213, 160, .75) !important;
}

.agri-app .agri-theme-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  z-index: 5;
}

.agri-app .agri-theme-toggle button {
  border: 1px solid rgba(190, 255, 202, .25);
  border-radius: 12px;
  padding: 9px;
  background: rgba(17, 48, 34, .85);
  color: #f4f6e9;
  cursor: pointer;
  transition: background .2s ease, transform .2s ease;
}

.agri-app .agri-theme-toggle button:hover {
  background: rgba(255, 174, 92, .2);
  transform: translateY(-1px);
}

@media (max-width: 700px) {
  .agri-app .agri-globe-wrap {
    width: 150px !important;
    height: 150px !important;
    right: 0 !important;
    opacity: .6 !important;
  }
}

/* Final override: visible Earth and warm orbital rings */
.agri-app .agri-hero {
  position: relative !important;
  isolation: isolate;
  min-height: 280px;
}

.agri-app .agri-hero > * {
  position: relative;
  z-index: 2;
}

.agri-app .agri-hero .agri-globe-wrap {
  display: block !important;
  position: absolute !important;
  width: 290px !important;
  height: 290px !important;
  right: 20px !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  opacity: 1 !important;
  z-index: 1 !important;
  pointer-events: none;
}

.agri-app .agri-hero .agri-globe {
  position: absolute !important;
  inset: 48px !important;
  border-radius: 50% !important;
  overflow: hidden;
  background-color: #087f5b !important;
  background-image:
    radial-gradient(circle at 30% 25%, rgba(255,255,255,.55), transparent 22%),
    url("https://images.unsplash.com/photo-1614730321146-b6fa6a46bcb4?auto=format&fit=crop&w=900&q=90") !important;
  background-position: center !important;
  background-size: cover !important;
  box-shadow:
    inset -24px -14px 32px rgba(0,0,0,.6),
    0 0 28px rgba(52,211,153,.35) !important;
}

.agri-app .agri-hero .agri-globe-shine {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: linear-gradient(110deg, transparent 35%, rgba(255,255,255,.18), transparent 68%);
}

.agri-app .agri-hero .agri-orbit {
  display: block !important;
  position: absolute !important;
  inset: 26px !important;
  border: 2px solid rgba(255,174,92,.95) !important;
  border-radius: 50% !important;
  transform: rotate(-28deg) scaleY(.38);
  box-shadow: 0 0 12px rgba(255,151,70,.35);
}

.agri-app .agri-hero .agri-orbit-two {
  inset: 12px !important;
  border-color: rgba(255,220,170,.85) !important;
  transform: rotate(35deg) scaleY(.48);
}

@media (max-width: 700px) {
  .agri-app .agri-hero .agri-globe-wrap {
    width: 150px !important;
    height: 150px !important;
    right: 0 !important;
    top: auto !important;
    bottom: 0 !important;
    transform: none !important;
    opacity: .75 !important;
  }
}

