/* Global Agriculture Intelligence — 3D globe */
.global-globe-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 390px;
  overflow: hidden;
  isolation: isolate;
  background:
    radial-gradient(ellipse at 50% 48%, rgba(16, 110, 76, .18), transparent 56%),
    radial-gradient(ellipse at center, #081511 0%, #030807 70%);
  border: 1px solid rgba(119, 232, 177, .13);
  border-radius: 22px;
}

.global-globe-stage canvas {
  max-width: 100%;
}

.global-globe-halo {
  position: absolute;
  width: 48%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: rgba(24, 186, 117, .08);
  filter: blur(65px);
  pointer-events: none;
  z-index: -1;
}

.global-globe-caption {
  position: absolute;
  bottom: 17px;
  left: 18px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 11px;
  border: 1px solid rgba(133, 232, 178, .18);
  border-radius: 999px;
  background: rgba(4, 20, 14, .78);
  color: #b5e8ca;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .13em;
  backdrop-filter: blur(12px);
  pointer-events: none;
}

.global-live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #70ef9b;
  box-shadow: 0 0 10px rgba(112, 239, 155, .8);
}

@media (max-width: 700px) {
  .global-globe-stage {
    min-height: 350px;
    border-radius: 16px;
  }

  .global-globe-caption {
    bottom: 10px;
    left: 10px;
    font-size: 9px;
  }
}

/* Global Agriculture Intelligence — 3D globe */
.global-globe-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 390px;
  overflow: hidden;
  isolation: isolate;
  background:
    radial-gradient(ellipse at 50% 48%, rgba(16, 110, 76, .18), transparent 56%),
    radial-gradient(ellipse at center, #081511 0%, #030807 70%);
  border: 1px solid rgba(119, 232, 177, .13);
  border-radius: 22px;
}

.global-globe-stage canvas {
