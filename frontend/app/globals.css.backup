/* Global Agriculture Intelligence — dark globe dashboard */
.agri-app {
  min-height: 100vh;
  color: #e6f4eb;
  background:
    radial-gradient(ellipse at 50% -10%, rgba(17, 105, 71, .20), transparent 42rem),
    #050b09;
}

.agri-app .agri-shell {
  max-width: 1680px;
}

.agri-app .agri-hero {
  background: linear-gradient(120deg, #0a3023, #071a14 72%) !important;
  border: 1px solid rgba(121, 220, 166, .15);
}

.agri-app .global-overview-grid {
  display: grid;
  grid-template-columns: minmax(190px, .72fr) minmax(0, 1.8fr) minmax(210px, .78fr);
  gap: 16px;
  align-items: stretch;
}

.agri-app .global-intro-panel,
.agri-app .global-insights-panel {
  min-width: 0;
  padding: 22px;
  border: 1px solid rgba(132, 206, 164, .14);
  border-radius: 22px;
  background: linear-gradient(145deg, rgba(16, 40, 29, .96), rgba(7, 19, 14, .96));
}

.agri-app .global-intro-panel {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.agri-app .global-eyebrow,
.agri-app .global-panel-kicker {
  color: #80dba6;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: .14em;
}

.agri-app .global-eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  line-height: 1.7;
}

.agri-app .global-title {
  margin-top: 24px;
  color: #f0faf3;
  font-size: clamp(25px, 2.5vw, 39px);
  font-weight: 650;
  line-height: 1.12;
  letter-spacing: -.045em;
}

.agri-app .global-description {
  margin-top: 15px;
  color: #a0b8aa;
  font-size: 13px;
  line-height: 1.8;
}

.agri-app .global-data-status {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 28px;
  padding-top: 17px;
  border-top: 1px solid rgba(132, 206, 164, .13);
  color: #91a99a;
  font-size: 9px;
  letter-spacing: .08em;
}

.agri-app .global-data-status strong {
  margin-left: auto;
  color: #8fe6aa;
  font-size: 9px;
}

.agri-app .global-globe-column {
  min-width: 0;
  overflow: hidden;
  border-radius: 22px;
}

.agri-app .global-globe-stage {
  height: 100%;
  min-height: 490px;
  border-color: rgba(101, 211, 153, .18);
  background:
    radial-gradient(ellipse at center, rgba(18, 95, 64, .19), transparent 62%),
    #030806;
}

.agri-app .global-insights-panel {
  display: flex;
  flex-direction: column;
}

.agri-app .global-panel-heading {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-bottom: 19px;
  border-bottom: 1px solid rgba(132, 206, 164, .13);
}

.agri-app .global-panel-icon {
  display: grid;
  width: 39px;
  height: 39px;
  flex-shrink: 0;
  place-items: center;
  border: 1px solid rgba(110, 219, 153, .2);
  border-radius: 12px;
  background: rgba(32, 116, 72, .19);
  color: #9be8ae;
}

.agri-app .global-panel-heading h3 {
  margin-top: 4px;
  color: #effaf2;
  font-size: 20px;
  font-weight: 650;
}

.agri-app .global-stat {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 17px 0;
  border-bottom: 1px solid rgba(132, 206, 164, .11);
}

.agri-app .global-stat > span,
.agri-app .global-stat small {
  color: #91a99a;
  font-size: 11px;
  line-height: 1.5;
}

.agri-app .global-stat strong {
  color: #e9f8ed;
  font-size: 25px;
  font-weight: 650;
  letter-spacing: -.035em;
  overflow-wrap: anywhere;
}

.agri-app .global-location-note {
  display: flex;
  gap: 10px;
  margin-top: auto;
  padding-top: 18px;
  color: #8fe6aa;
}

.agri-app .global-location-note p {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}

.agri-app .global-location-note strong {
  color: #d9f1e0;
  font-size: 12px;
}

.agri-app .global-location-note span {
  color: #91a99a;
  font-size: 10px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.agri-app #overview > article,
.agri-app #overview .dashboard-card {
  border-color: rgba(132, 206, 164, .14);
}

.agri-app nav a {
  border-color: rgba(132, 206, 164, .16) !important;
  background: #102219 !important;
  color: #c5e2cf !important;
}

.agri-app nav a:hover {
  background: #173827 !important;
}

@media (max-width: 1150px) {
  .agri-app .global-overview-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .agri-app .global-intro-panel {
    grid-column: 1 / -1;
  }

  .agri-app .global-globe-stage {
    min-height: 430px;
  }
}

@media (max-width: 700px) {
  .agri-app .global-overview-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .agri-app .global-intro-panel {
    grid-column: auto;
  }

  .agri-app .global-title {
    margin-top: 15px;
  }

  .agri-app .global-globe-stage {
    min-height: 390px;
  }
}

/* Full-viewport Earth experience */
.agri-app {
  padding: 0 !important;
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
}

.agri-app .agri-shell {
  width: 100%;
  max-width: none !important;
  margin: 0 !important;
  padding: 20px 28px 40px;
}

.agri-app .global-overview-grid {
  position: relative;
  display: block !important;
  width: 100%;
  height: calc(100vh - 150px);
  min-height: 620px;
  overflow: hidden;
  border: 1px solid rgba(132, 206, 164, .15);
  border-radius: 24px;
  background: #030806;
}

.agri-app .global-globe-column {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: inherit;
}

.agri-app .global-globe-stage {
  width: 100% !important;
  height: 100% !important;
  min-height: 100% !important;
  border: 0;
  border-radius: inherit;
}

.agri-app .global-globe-stage canvas {
  max-width: none !important;
}

.agri-app .global-intro-panel {
  position: absolute;
  z-index: 2;
  top: 24px;
  left: 24px;
  width: min(310px, calc(100% - 48px));
  padding: 22px;
  background: rgba(5, 19, 13, .78);
  border-color: rgba(132, 206, 164, .2);
  backdrop-filter: blur(18px);
}

.agri-app .global-insights-panel {
  position: absolute;
  z-index: 2;
  top: 24px;
  right: 24px;
  width: min(285px, calc(100% - 48px));
  max-height: calc(100% - 48px);
  overflow-y: auto;
  background: rgba(5, 19, 13, .82);
  border-color: rgba(132, 206, 164, .2);
  backdrop-filter: blur(18px);
}

@media (min-width: 1400px) {
  .agri-app .global-overview-grid {
    height: calc(100vh - 145px);
    min-height: 700px;
  }
}

@media (max-width: 700px) {
  .agri-app .agri-shell {
    padding: 12px 12px 28px;
  }

  .agri-app .global-overview-grid {
    height: 850px;
    min-height: 850px;
  }

  .agri-app .global-intro-panel {
    top: 12px;
    left: 12px;
    width: calc(100% - 24px);
    padding: 15px;
  }

  .agri-app .global-title {
    font-size: 26px;
    margin-top: 10px;
  }

  .agri-app .global-description {
    margin-top: 8px;
  }

  .agri-app .global-data-status {
    margin-top: 12px;
    padding-top: 10px;
  }

  .agri-app .global-insights-panel {
    top: auto;
    right: 12px;
    bottom: 12px;
    left: 12px;
    width: auto;
    max-height: 310px;
    padding: 15px;
  }

  .agri-app .global-stat {
    padding: 10px 0;
  }

  .agri-app .global-stat strong {
    font-size: 20px;
  }
}

/* Layout repair: full-width dashboard and viewport-sized globe */
html,
body {
  width: 100%;
  min-width: 0;
  margin: 0;
}

.agri-app {
  display: block !important;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  overflow-x: hidden;
  box-sizing: border-box;
}

.agri-app .agri-shell {
  display: flex !important;
  flex-direction: column !important;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  margin: 0 !important;
  padding: 20px 24px 40px !important;
  box-sizing: border-box !important;
}

.agri-app .agri-shell > header {
  position: relative;
  display: flex !important;
  width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
}

.agri-app .agri-shell > nav {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: wrap !important;
  width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
}

.agri-app .global-overview-grid {
  position: relative !important;
  display: block !important;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  height: calc(100vh - 180px) !important;
  min-height: 600px !important;
  box-sizing: border-box !important;
}

.agri-app .global-globe-column {
  position: absolute !important;
  inset: 0 !important;
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  min-width: 0 !important;
}

.agri-app .global-globe-stage {
  position: absolute !important;
  inset: 0 !important;
  display: flex !important;
  width: 100% !important;
  height: 100% !important;
  min-height: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
}

.agri-app .global-globe-stage > div:not(.global-globe-halo):not(.global-globe-caption) {
  max-width: none !important;
}

.agri-app #overview,
.agri-app #global-overview,
.agri-app section {
  min-width: 0;
}

@media (max-width: 700px) {
  .agri-app .agri-shell {
    padding: 12px 12px 28px !important;
  }

  .agri-app .global-overview-grid {
    height: 850px !important;
    min-height: 850px !important;
  }
}

